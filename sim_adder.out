#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fd008ecb600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fd008ecb790 .scope module, "tb_adder" "tb_adder" 3 3;
 .timescale 0 0;
P_0x5fd008ecb920 .param/l "WIDTH" 0 3 6, +C4<00000000000000000000000000001000>;
v0x5fd008ede010_0 .var "in_a", 7 0;
v0x5fd008ede100_0 .var "in_b", 7 0;
v0x5fd008ede1d0_0 .net "out_sum", 8 0, v0x5fd008eddea0_0;  1 drivers
S_0x5fd008e91530 .scope module, "dut" "adder" 3 14, 4 1 0, S_0x5fd008ecb790;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 9 "sum";
P_0x5fd008e91710 .param/l "WIDTH" 0 4 2, +C4<00000000000000000000000000001000>;
v0x5fd008e91830_0 .net "a", 7 0, v0x5fd008ede010_0;  1 drivers
v0x5fd008edddc0_0 .net "b", 7 0, v0x5fd008ede100_0;  1 drivers
v0x5fd008eddea0_0 .var "sum", 8 0;
E_0x5fd008ecce30 .event anyedge, v0x5fd008e91830_0, v0x5fd008edddc0_0;
    .scope S_0x5fd008e91530;
T_0 ;
Ewait_0 .event/or E_0x5fd008ecce30, E_0x0;
    %wait Ewait_0;
    %load/vec4 v0x5fd008e91830_0;
    %pad/u 9;
    %load/vec4 v0x5fd008edddc0_0;
    %pad/u 9;
    %add;
    %store/vec4 v0x5fd008eddea0_0, 0, 9;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5fd008ecb790;
T_1 ;
    %vpi_call/w 3 23 "$dumpfile", "waves_adder.vcd" {0 0 0};
    %vpi_call/w 3 24 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fd008ecb790 {0 0 0};
    %pushi/vec4 10, 0, 8;
    %store/vec4 v0x5fd008ede010_0, 0, 8;
    %pushi/vec4 20, 0, 8;
    %store/vec4 v0x5fd008ede100_0, 0, 8;
    %delay 10, 0;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5fd008ede010_0, 0, 8;
    %pushi/vec4 1, 0, 8;
    %store/vec4 v0x5fd008ede100_0, 0, 8;
    %delay 10, 0;
    %pushi/vec4 100, 0, 8;
    %store/vec4 v0x5fd008ede010_0, 0, 8;
    %pushi/vec4 50, 0, 8;
    %store/vec4 v0x5fd008ede100_0, 0, 8;
    %delay 10, 0;
    %vpi_call/w 3 42 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_adder.sv";
    "./adder.sv";
